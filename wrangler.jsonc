{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vecta",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "local",
    "AUTH_MODE": "local",
    "AUTH_EMAIL_PROVIDER": "disabled",
    "TURNSTILE_SITEKEY": "1x00000000000000000000AA",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET", "ATTEMPT_TOKEN_SECRET"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vecta-local",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PARTICIPANT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging-public": {
      "name": "vecta-staging-public",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "AUTH_MODE": "disabled",
        "AUTH_EMAIL_PROVIDER": "disabled",
        "TURNSTILE_SITEKEY": "0x4AAAAAAEj1j4-iOBfV8uPo",
        "TURNSTILE_HOSTNAMES": "vecta-staging-public.alimbekov1234567890.workers.dev"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET", "ATTEMPT_TOKEN_SECRET"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vecta-staging",
          "database_id": "fcbe1d68-f3ec-4d9b-966e-202a288fe8fc",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "PARTICIPANT_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 20, "period": 60 }
        }
      ]
    },
    "staging-organizer": {
      "name": "vecta-staging-organizer",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "AUTH_MODE": "session",
        "AUTH_EMAIL_PROVIDER": "brevo",
        "TURNSTILE_SITEKEY": "0x4AAAAAAEj1j4-iOBfV8uPo",
        "TURNSTILE_HOSTNAMES": "vecta-staging-organizer.alimbekov1234567890.workers.dev"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET", "ATTEMPT_TOKEN_SECRET", "AUTH_TOKEN_SECRET", "AUTH_EMAIL_FROM", "BREVO_API_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vecta-staging",
          "database_id": "fcbe1d68-f3ec-4d9b-966e-202a288fe8fc",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "PARTICIPANT_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    },
    "production-public": {
      "name": "vecta-public",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "AUTH_MODE": "disabled",
        "AUTH_EMAIL_PROVIDER": "disabled",
        "TURNSTILE_SITEKEY": "0x4AAAAAAEj1j4-iOBfV8uPo",
        "TURNSTILE_HOSTNAMES": "vecta-public.alimbekov1234567890.workers.dev"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET", "ATTEMPT_TOKEN_SECRET"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vecta-production",
          "database_id": "44ad08b1-d7e0-49d7-ad25-9594f50a1227",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "PARTICIPANT_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 20, "period": 60 }
        }
      ]
    },
    "production-organizer": {
      "name": "vecta-organizer",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "AUTH_MODE": "session",
        "AUTH_EMAIL_PROVIDER": "resend",
        "TURNSTILE_SITEKEY": "0x4AAAAAAEj1j4-iOBfV8uPo",
        "TURNSTILE_HOSTNAMES": "vecta-organizer.alimbekov1234567890.workers.dev"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET", "ATTEMPT_TOKEN_SECRET", "AUTH_TOKEN_SECRET", "AUTH_EMAIL_FROM", "RESEND_API_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vecta-production",
          "database_id": "44ad08b1-d7e0-49d7-ad25-9594f50a1227",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "PARTICIPANT_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
