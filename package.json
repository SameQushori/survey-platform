{
  "name": "vecta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging:public": "node scripts/build-cloudflare.mjs staging-public",
    "build:staging:organizer": "node scripts/build-cloudflare.mjs staging-organizer",
    "build:production:public": "node scripts/build-cloudflare.mjs production-public",
    "build:production:organizer": "node scripts/build-cloudflare.mjs production-organizer",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/worker/**",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:all": "npm run test && npm run test:worker",
    "quality": "npm run typecheck && npm run lint && npm run test:all && npm run build && npm audit --audit-level=moderate",
    "test:watch": "vitest",
    "preview": "vite preview",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply vecta-local --local",
    "db:seed:local": "wrangler d1 execute vecta-local --local --file scripts/seed-local.sql"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "jose": "^6.2.12",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/js": "^9.39.5",
    "@msw/cloudflare": "^0.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "msw": "^2.15.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "@humanfs/node": "0.16.8"
  }
}
